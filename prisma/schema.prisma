generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                    String   @id
  twitchId              String   @unique
  username              String
  displayName           String
  avatarUrl             String   @default("")
  channelColor          String   @default("")
  timezone              String   @default("UTC")
  hasCompletedOnboarding Boolean   @default(false)
  discordId             String?
  discordUsername       String?
  discordAccessToken    String?
  discordRefreshToken   String?
  discordTokenExpiry    DateTime?
  discordGuildId        String?
  discordGuildName      String?
  discordChannelId      String?
  discordChannelName    String?
  discordWebhookUrl     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Friend {
  id               Int                @id @default(autoincrement())
  userId           String
  twitchId         String
  username         String
  displayName      String
  avatarUrl        String             @default("")
  notes            String             @default("")
  isActive         Boolean            @default(true)
  isMe             Boolean            @default(false)
  isSuggested      Boolean            @default(false)
  isFavorite       Boolean            @default(false)
  discordUsername  String?
  channelColor     String             @default("")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  collabHistories  CollabHistory[]
  collabSignals    CollabSignal[]
  participants     EventParticipant[]
  scheduleSegments ScheduleSegment[]
  streamHistory    StreamHistory[]

  @@unique([userId, twitchId])
  @@unique([userId, username])
}

model StreamHistory {
  id          Int      @id @default(autoincrement())
  friendId    Int
  videoId     String
  title       String
  startTime   DateTime
  endTime     DateTime
  durationSec Int      @default(0)
  gameName    String   @default("")
  gameId      String   @default("")
  fetchedAt   DateTime @default(now())
  friend      Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([friendId, videoId])
}

model ScheduleSegment {
  id          Int      @id @default(autoincrement())
  friendId    Int
  segmentId   String   @default("")
  title       String
  startTime   DateTime
  endTime     DateTime
  gameName    String   @default("")
  gameId      String   @default("")
  isRecurring Boolean  @default(false)
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  friend      Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
}

model Event {
  id                    Int                @id @default(autoincrement())
  userId                String
  title                 String
  description           String             @default("")
  startTime             DateTime
  endTime               DateTime
  gameName              String             @default("")
  gameId                String             @default("")
  status                String             @default("planned")
  googleCalendarEventId String             @default("")
  googleCalendarLink    String             @default("")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  collabHistory         CollabHistory[]
  participants          EventParticipant[]
  messageLogs           MessageLog[]
  reminders             Reminder[]
}

model EventParticipant {
  id           Int      @id @default(autoincrement())
  eventId      Int
  friendId     Int
  inviteStatus String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  friend       Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([eventId, friendId])
}

model CollabSignal {
  id           Int      @id @default(autoincrement())
  friendId     Int
  partnerName  String
  partnerLogin String   @default("")
  detectedAt   DateTime
  source       String
  evidence     String
  confidence   String   @default("medium")
  fetchedAt    DateTime @default(now())
  friend       Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([friendId, partnerLogin, detectedAt])
}

model CollabHistory {
  id        Int      @id @default(autoincrement())
  eventId   Int?
  friendId  Int
  title     String
  gameName  String   @default("")
  date      DateTime
  notes     String   @default("")
  createdAt DateTime @default(now())
  event     Event?   @relation(fields: [eventId], references: [id])
  friend    Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        Int      @id @default(autoincrement())
  eventId   Int
  remindAt  DateTime
  label     String   @default("")
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model MessageLog {
  id          Int      @id @default(autoincrement())
  userId      String
  eventId     Int?
  messageType String
  content     String
  createdAt   DateTime @default(now())
  event       Event?   @relation(fields: [eventId], references: [id])
}

model GoogleAuth {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CollabInvite {
  id                      Int       @id @default(autoincrement())
  token                   String    @unique @default(cuid())
  creatorUserId           String
  creatorDisplayName      String    @default("")
  creatorAvatarUrl        String    @default("")
  creatorUsername         String    @default("")
  title                   String    @default("Collab Stream")
  gameName                String    @default("")
  description             String    @default("")
  message                 String    @default("")
  participantUsernames    String[]
  participantDisplayNames String[]
  participantAvatarUrls   String[]
  expiresAt               DateTime?
  usedCount               Int       @default(0)
  maxUses                 Int?
  createdAt               DateTime  @default(now())
  recipients              CollabInviteRecipient[]
}

model CollabInviteRecipient {
  id           Int          @id @default(autoincrement())
  inviteId      Int
  username      String
  displayName   String      @default("")
  avatarUrl     String      @default("")
  status        String      @default("pending")
  respondedAt   DateTime?
  claimedAt     DateTime?
  claimedByUserId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  invite        CollabInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@unique([inviteId, username])
}
